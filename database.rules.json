{
  "rules": {
    ".read": false,
    ".write": false,
    "publicApplications": {
      "$applicationId": {
        ".read": false,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['athleteName','birthDate','category','guardianName','phone','createdAt','status']) && newData.child('status').val() === 'Nova'"
      }
    },
    "clubs": {
      "$clubId": {
        ".read": "auth != null && root.child('members').child($clubId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($clubId).child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "healthRecords": {
      "$clubId": {
        "$studentId": {
          ".read": "auth != null && (root.child('members').child($clubId).child(auth.uid).child('role').val() === 'admin' || root.child('members').child($clubId).child(auth.uid).child('role').val() === 'secretaria' || root.child('members').child($clubId).child(auth.uid).child('role').val() === 'treinador' || root.child('members').child($clubId).child(auth.uid).child('role').val() === 'coordenacao')",
          ".write": "auth != null && (root.child('members').child($clubId).child(auth.uid).child('role').val() === 'admin' || root.child('members').child($clubId).child(auth.uid).child('role').val() === 'secretaria')"
        }
      }
    },
    "members": {
      "$clubId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
